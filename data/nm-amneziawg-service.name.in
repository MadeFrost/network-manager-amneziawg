[VPN Connection]
name=amneziawg
service=org.freedesktop.NetworkManager.amneziawg
program=@LIBEXECDIR@/nm-amneziawg-service
supports-multiple-connections=true

[libnm]
plugin=libnm-vpn-plugin-amneziawg.so

[GNOME]
